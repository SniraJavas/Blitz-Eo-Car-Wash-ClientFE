<?xml version="1.0" encoding="utf-8" ?>
<!--
    VehicleSelectionPage.xaml
    =========================
    PLACEMENT: BlitzEcoCarWash/Pages/VehicleSelectionPage.xaml

    Step 2: User selects their vehicle type.
    Navigation: → PackageSelectionPage (Continue tapped)
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlitzEcoCarWash.Pages.VehicleSelectionPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundPage}">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*"
              BackgroundColor="{StaticResource White}" Padding="20,50,20,16">
            <ImageButton Grid.Column="0" Source="arrow_back.png"
                         HeightRequest="24" WidthRequest="24" Clicked="OnBackClicked" />
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                <Label Text="Select Vehicle" FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                <Label Text="Choose your vehicle type" FontSize="12"
                       TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="14">

                <!-- Vehicle Grid -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">

                    <!-- Sedan (selected) -->
                    <Frame Grid.Row="0" Grid.Column="0" CornerRadius="16" HasShadow="True"
                           BackgroundColor="{StaticResource White}"
                           BorderColor="{StaticResource PrimaryGreen}" Padding="16">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="🚗" FontSize="52" HorizontalOptions="Center"/>
                            <Label Text="Sedan" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            <Label Text="From R120" FontSize="13"
                                   TextColor="{StaticResource PrimaryGreen}" HorizontalOptions="Center"/>
                            <Frame BackgroundColor="{StaticResource PrimaryGreen}" CornerRadius="12"
                                   Padding="8,4" HasShadow="False" HorizontalOptions="Center">
                                <Label Text="✓ Selected" FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource White}"/>
                            </Frame>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- SUV -->
                    <Frame Grid.Row="0" Grid.Column="1" CornerRadius="16" HasShadow="False"
                           BackgroundColor="{StaticResource White}"
                           BorderColor="{StaticResource BorderColor}" Padding="16">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="🚙" FontSize="52" HorizontalOptions="Center"/>
                            <Label Text="SUV" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            <Label Text="From R150" FontSize="13"
                                   TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Bakkie -->
                    <Frame Grid.Row="1" Grid.Column="0" CornerRadius="16" HasShadow="False"
                           BackgroundColor="{StaticResource White}"
                           BorderColor="{StaticResource BorderColor}" Padding="16">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="🛻" FontSize="52" HorizontalOptions="Center"/>
                            <Label Text="Bakkie" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            <Label Text="From R140" FontSize="13"
                                   TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- MPV / Van -->
                    <Frame Grid.Row="1" Grid.Column="1" CornerRadius="16" HasShadow="False"
                           BackgroundColor="{StaticResource White}"
                           BorderColor="{StaticResource BorderColor}" Padding="16">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="🚐" FontSize="52" HorizontalOptions="Center"/>
                            <Label Text="MPV / Van" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            <Label Text="From R160" FontSize="13"
                                   TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Continue Button -->
        <VerticalStackLayout Grid.Row="2" Padding="20,12,20,32"
                             BackgroundColor="{StaticResource White}">
            <Button Text="Continue →"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Clicked="OnContinueClicked" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>

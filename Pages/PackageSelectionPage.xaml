<?xml version="1.0" encoding="utf-8" ?>
<!--
    PackageSelectionPage.xaml
    =========================
    PLACEMENT: BlitzEcoCarWash/Pages/PackageSelectionPage.xaml
    Step 3: Select a wash package. Navigation: → OrderSummaryPage
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlitzEcoCarWash.Pages.PackageSelectionPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundPage}">

    <Grid RowDefinitions="Auto, *, Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*"
              BackgroundColor="{StaticResource White}" Padding="20,50,20,16">
            <ImageButton Grid.Column="0" Source="arrow_back.png"
                         HeightRequest="24" WidthRequest="24" Clicked="OnBackClicked"/>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                <Label Text="Select Package" FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                <Label Text="Choose the perfect wash for your car" FontSize="12"
                       TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="14">

                <!-- Basic Wash -->
                <Frame CornerRadius="16" HasShadow="False" BackgroundColor="{StaticResource White}"
                       BorderColor="{StaticResource BorderColor}" Padding="18">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Basic Wash" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Exterior wash, wheels &amp; windows"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="R120" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                        <RadioButton Grid.Column="1" IsChecked="True" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Premium Wash (selected) -->
                <Frame CornerRadius="16" HasShadow="True" BackgroundColor="{StaticResource White}"
                       BorderColor="{StaticResource PrimaryGreen}" Padding="18">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Premium Wash ⭐" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryGreen}"/>
                            <Label Text="Exterior + Interior vacuum &amp; dashboard clean"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="R180" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryGreen}" Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                        <RadioButton Grid.Column="1" IsChecked="True" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Eco Wash -->
                <Frame CornerRadius="16" HasShadow="False" BackgroundColor="{StaticResource White}"
                       BorderColor="{StaticResource BorderColor}" Padding="18">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Eco Wash" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Frame BackgroundColor="#E8F5E9" CornerRadius="8" Padding="6,2" HasShadow="False">
                                    <Label Text="🌿 Eco" FontSize="11" TextColor="{StaticResource PrimaryGreen}"/>
                                </Frame>
                            </HorizontalStackLayout>
                            <Label Text="Premium wash using eco-friendly products"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="R220" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                        <RadioButton Grid.Column="1" IsChecked="True" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Eco note -->
                <Frame BackgroundColor="#E8F5E9" CornerRadius="12" HasShadow="False"
                       BorderColor="Transparent" Padding="14">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="✅" FontSize="16" VerticalOptions="Center"/>
                        <Label Text="All packages are eco-friendly and water efficient."
                               FontSize="13" TextColor="{StaticResource DarkGreen}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="20,12,20,32" BackgroundColor="{StaticResource White}">
            <Button Text="Continue →" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnContinueClicked"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>

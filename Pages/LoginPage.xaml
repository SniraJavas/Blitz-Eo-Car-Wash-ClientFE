<?xml version="1.0" encoding="utf-8" ?>
<!--
    LoginPage.xaml
    ==============
    PLACEMENT: BlitzEcoCarWash/Pages/LoginPage.xaml

    Login screen for returning users.
    Navigation from here:
      → Back (←)       → LandingPage (Shell back stack)
      → Login button   → HomePage
      → "Sign up" link → RegisterPage
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlitzEcoCarWash.Pages.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource White}">

    <ScrollView>
        <VerticalStackLayout Padding="32,60,32,40" Spacing="0">

            <!-- Back Arrow -->
            <ImageButton Source="arrow_back.png"
                         HorizontalOptions="Start"
                         HeightRequest="24" WidthRequest="24"
                         Margin="0,0,0,32"
                         Clicked="OnBackClicked" />

            <!-- Logo -->
            <Frame BackgroundColor="{StaticResource PrimaryGreen}"
                   CornerRadius="40"
                   HeightRequest="80"
                   WidthRequest="80"
                   HorizontalOptions="Center"
                   HasShadow="True"
                   Padding="0"
                   Margin="0,0,0,20">
                <Label Text="🍃" FontSize="36"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Frame>

            <!-- Header -->
            <Label Text="Welcome Back!"
                   Style="{StaticResource PageTitleStyle}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,6" />
            <Label Text="Login to continue"
                   Style="{StaticResource SubtitleStyle}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,36" />

            <!-- Email Field -->
            <Label Text="Email" FontSize="13" FontAttributes="Bold"
                   TextColor="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
            <Frame BackgroundColor="{StaticResource OffWhite}"
                   CornerRadius="12" HasShadow="False"
                   Padding="16,0" Margin="0,0,0,16"
                   BorderColor="{StaticResource BorderColor}">
                <Entry Placeholder="you@example.com"
                       Keyboard="Email"
                       Style="{StaticResource InputEntryStyle}"
                       BackgroundColor="Transparent" />
            </Frame>

            <!-- Password Field -->
            <Label Text="Password" FontSize="13" FontAttributes="Bold"
                   TextColor="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
            <Frame BackgroundColor="{StaticResource OffWhite}"
                   CornerRadius="12" HasShadow="False"
                   Padding="16,0" Margin="0,0,0,4"
                   BorderColor="{StaticResource BorderColor}">
                <Entry Placeholder="Enter your password"
                       IsPassword="True"
                       Style="{StaticResource InputEntryStyle}"
                       BackgroundColor="Transparent" />
            </Frame>

            <!-- Forgot Password -->
            <Label Text="Forgot Password?"
                   TextColor="{StaticResource PrimaryGreen}"
                   FontSize="13" FontAttributes="Bold"
                   HorizontalOptions="End"
                   Margin="0,0,0,28">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Login Button → HomePage -->
            <Button Text="Login"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Clicked="OnLoginClicked"
                    Margin="0,0,0,20" />

            <!-- Divider -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,0,0,20">
                <BoxView HeightRequest="1" WidthRequest="80"
                         BackgroundColor="{StaticResource BorderColor}"
                         VerticalOptions="Center" />
                <Label Text="Or continue with" FontSize="12"
                       TextColor="{StaticResource MidGray}" />
                <BoxView HeightRequest="1" WidthRequest="80"
                         BackgroundColor="{StaticResource BorderColor}"
                         VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Social Login Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,28">
                <Frame Grid.Column="0" CornerRadius="12" HasShadow="False"
                       BorderColor="{StaticResource BorderColor}" Padding="0">
                    <Button Text="G  Google"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="14"
                            HeightRequest="48" />
                </Frame>
                <Frame Grid.Column="1" CornerRadius="12" HasShadow="False"
                       BorderColor="{StaticResource BorderColor}" Padding="0">
                    <Button Text="f  Facebook"
                            BackgroundColor="Transparent"
                            TextColor="#1877F2"
                            FontSize="14"
                            HeightRequest="48" />
                </Frame>
            </Grid>

            <!-- Sign Up Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label Text="Don't have an account?"
                       FontSize="14" TextColor="{StaticResource TextSecondary}" />
                <Label Text="Sign up"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryGreen}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignUpTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

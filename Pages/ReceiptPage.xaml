<?xml version="1.0" encoding="utf-8" ?>
<!--
    ReceiptPage.xaml
    ================
    PLACEMENT: BlitzEcoCarWash/Pages/ReceiptPage.xaml
    Booking confirmed screen. Navigation: → TrackingPage or HomePage
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlitzEcoCarWash.Pages.ReceiptPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PrimaryGreen}">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,80,24,24" Spacing="0">

                <!-- Success Icon -->
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="50"
                       HeightRequest="100" WidthRequest="100" HasShadow="True"
                       HorizontalOptions="Center" Padding="0" Margin="0,0,0,20">
                    <Label Text="✅" FontSize="52"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>

                <Label Text="Booking Confirmed!" FontSize="26" FontAttributes="Bold"
                       TextColor="{StaticResource White}" HorizontalOptions="Center"
                       Margin="0,0,0,8"/>
                <Label Text="We've received your booking." FontSize="14"
                       TextColor="#C8E6C9" HorizontalOptions="Center" Margin="0,0,0,32"/>

                <!-- Receipt Card -->
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="20"
                       HasShadow="True" Padding="24">
                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Booking ID" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Label Grid.Column="1" Text="#BEW-250515-1023" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Date &amp; Time" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Label Grid.Column="1" Text="15 May 2025, 12:00" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Vehicle" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Label Grid.Column="1" Text="Sedan" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Package" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Label Grid.Column="1" Text="Premium Wash" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Location" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Label Grid.Column="1" Text="123 Greenway St, Pretoria" FontSize="13"
                                   FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                                   HorizontalTextAlignment="End"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Total Paid" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Grid.Column="1" Text="R200" FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryGreen}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Action Buttons -->
        <VerticalStackLayout Grid.Row="1" Padding="24,12,24,48" Spacing="12">
            <Button Text="Track Your Wash"
                    BackgroundColor="{StaticResource White}"
                    TextColor="{StaticResource PrimaryGreen}"
                    FontAttributes="Bold" CornerRadius="12"
                    HeightRequest="52"
                    Clicked="OnTrackClicked" />
            <Button Text="Back to Home"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold" CornerRadius="12"
                    HeightRequest="52"
                    BorderColor="{StaticResource White}" BorderWidth="2"
                    Clicked="OnHomeClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<!--
    OrderSummaryPage.xaml
    =====================
    PLACEMENT: BlitzEcoCarWash/Pages/OrderSummaryPage.xaml
    Step 4: Review booking summary. Navigation: → PaymentPage
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlitzEcoCarWash.Pages.OrderSummaryPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundPage}">

    <Grid RowDefinitions="Auto, *, Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*"
              BackgroundColor="{StaticResource White}" Padding="20,50,20,16">
            <ImageButton Grid.Column="0" Source="arrow_back.png"
                         HeightRequest="24" WidthRequest="24" Clicked="OnBackClicked"/>
            <Label Grid.Column="1" Text="Order Summary" FontSize="18" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="24,*,Auto">
                            <Label Text="🚗" FontSize="18" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Vehicle" FontSize="14"
                                   TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="Sedan" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"/>

                        <Grid ColumnDefinitions="24,*,Auto">
                            <Label Text="✨" FontSize="18" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Package" FontSize="14"
                                   TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="Premium Wash" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"/>

                        <Grid ColumnDefinitions="24,*,Auto">
                            <Label Text="📅" FontSize="18" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Date &amp; Time" FontSize="14"
                                   TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="15 May 2025, 12:00" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"/>

                        <Grid ColumnDefinitions="24,*,Auto">
                            <Label Text="📍" FontSize="18" VerticalOptions="Start"/>
                            <Label Grid.Column="1" Text="Location" FontSize="14"
                                   TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="123 Greenway St,&#10;Pretoria" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="End"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Price Breakdown -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Subtotal" FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <Label Grid.Column="1" Text="R180" FontSize="14"
                                   TextColor="{StaticResource TextPrimary}" FontAttributes="Bold"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Service Fee" FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <Label Grid.Column="1" Text="R20" FontSize="14"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Total" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Grid.Column="1" Text="R200" FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryGreen}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="20,12,20,32" BackgroundColor="{StaticResource White}">
            <Button Text="Proceed to Payment" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnPayClicked"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
